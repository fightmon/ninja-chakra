/* 捲動連動(支援的瀏覽器才有)：往下捲，主視覺的島慢慢沉下去 */
@supports (animation-timeline:scroll()){
  @media(prefers-reduced-motion:no-preference){
    .hero-in{animation:hp-heroout linear both;animation-timeline:scroll(root);animation-range:0 90vh}
    @keyframes hp-heroout{to{translate:0 90px;opacity:.25}}
  }
}

/* ══════════ keyframes ══════════ */
@keyframes hp-up{from{opacity:0;translate:0 26px}to{opacity:1;translate:none}}
@keyframes hp-pop{from{opacity:0;scale:.86;translate:0 40px}to{opacity:1;scale:1;translate:none}}
