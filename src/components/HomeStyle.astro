@keyframes hp-dmg{0%{opacity:0;translate:-50% 10px;scale:.6}25%{opacity:1;scale:1.15}100%{opacity:0;translate:-50% -46px;scale:1}}
@keyframes hp-tg{from{opacity:.45}to{opacity:1}}
@keyframes hp-cpop{0%{scale:1}35%{scale:1.16;filter:brightness(2.4)}100%{scale:.2;opacity:0}}
@keyframes hp-nudge{0%,60%,100%{translate:0}75%{translate:0 -9px}88%{translate:0 0}94%{translate:0 -4px}}
@keyframes hp-foin{from{opacity:0;translate:0 26px;scale:.8}to{opacity:1;translate:none;scale:1}}
@keyframes hp-swap{from{opacity:0;scale:calc(var(--sc,1)*.9)}to{opacity:1;scale:var(--sc,1)}}

