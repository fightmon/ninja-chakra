  { id: 'wind', name: L('風之峽谷', 'Wind Canyon'), el: 'wind', tip: L('各種盜賊聚集的峽谷，小心別被偷。', 'A canyon full of thieves. Don’t let them steal from you.'), foe: L('賊鴨', 'Thief Ducks'), fid: 'c55', bg: 'wind', pos: isle(234, 484, 464, 485) },
