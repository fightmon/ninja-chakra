  sep: L('｜', ' · '),
  m1: L('把下面的方塊拖上去，補滿發亮的那一排', 'Drag the block up and fill the glowing gap'), ok1: L('消 9 格，就是 9 HIT！', '9 cells cleared. That’s 9 HIT!'),
  m2: L('再一手：這次一排加一宮，一起清掉', 'One more: clear a row and a box at once'), ok2: L('一次清兩條，打得更痛！', 'Two clears in one move hits harder!'),
  miss: L('差一點！要補滿一整排才會消。再試一次', 'So close! Fill the whole line to clear it. Try again'),
};

const data = { teams, places, EL, t: js };
const ld = {
  '@context': 'https://schema.org', '@type': 'VideoGame', name: '塊頭勇者 Blockyusha', alternateName: 'Blockyusha', url: en ? 'https://blockyusha.com/en/' : 'https://blockyusha.com/',
  description: T.desc, genre: ['Puzzle', 'RPG'], gamePlatform: ['Web Browser', 'Android', 'iOS'], applicationCategory: 'Game', operatingSystem: 'Any',
  inLanguage: ['zh-TW', 'en'], image: 'https://blockyusha.com/home/og.jpg',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TWD' }, author: { '@type': 'Person', name: L('戰鬥毛', 'fightmao') },
};
const boxEl = ['fire', '', 'water', '', 'thunder', '', 'earth', '', 'wind'];
const tkEl = ['fire', 'water', 'thunder', 'earth', 'wind', 'fire', 'water'];
---
<Base title={T.title} description={T.desc} path={en ? '/en/' : '/'} alt={en ? '/' : '/en/'} lang={lang} navActive="home" home image="/home/og.jpg">
<Fragment slot="head">
  <script is:inline>document.documentElement.classList.add("js");</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chiron+GoRound+TC:wght@500;900&family=Russo+One&display=swap" />
  <link rel="preload" as="image" href="/home/hero-island.webp" fetchpriority="high" />
  <link rel="preload" as="image" href="/home/sky.webp" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Fragment>

<main class={'hp' + (en ? ' is-en' : '')}>

<!-- ═════════ HERO ═════════ -->
<section class="hero" id="top">
  <div class="sky" aria-hidden="true">
    <i class="sun"></i>
    <i class="cube c-fire" style="--x:7%;--y:22%;--s:54px;--r:-14deg;--t:7s"></i>
    <i class="cube c-water" style="--x:44%;--y:13%;--s:34px;--r:18deg;--t:9s"></i>
    <i class="cube c-thunder" style="--x:93%;--y:20%;--s:46px;--r:10deg;--t:8s"></i>
    <i class="cube c-wind" style="--x:3%;--y:72%;--s:38px;--r:22deg;--t:10s"></i>
    <i class="cube c-earth" style="--x:96%;--y:66%;--s:30px;--r:-20deg;--t:11s"></i>
  </div>
  <div class="w hero-in">
    <div class="hero-copy">
      <p class="pill"><i></i>{T.pill}<span>{T.free}</span></p>
      <h1 class="logo"><img src="/home/logo-clean.webp" alt={T.logoAlt} width="801" height="602" />{en && <span class="logo-en">BLOCKYUSHA</span>}</h1>
      <p class="tag">{T.tagA}<br /><em>{T.tagEm}</em>{T.tagZ}</p>
      <p class="sub">{T.sub}</p>
      <div class="cta-row">
        <a class="btn btn-go" href="/play/"><span class="bi" set:html={ico('play', 22)} /><span><b>{T.play}</b><small>{T.playS}</small></span></a>
        <a class="btn btn-ghost" href="#play">{T.tryIt}<span class="bi" set:html={ico('arrow-down', 18)} /></a>
      </div>
      <ul class="badges">
        <li><span set:html={ico('globe', 17)} />{T.b1}</li>
        <li><span set:html={ico('smartphone', 17)} />{T.b2}</li>
        <li><span set:html={ico('gift', 17)} />{T.b3}</li>
      </ul>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="float">
        <img class="island" src="/home/hero-island.webp" srcset="/home/hero-island-640.webp 640w, /home/hero-island.webp 1034w" sizes="(max-width:900px) 60vw, 620px" alt="" width="1034" height="1011" fetchpriority="high" />
      </div>
      <i class="isl-shadow"></i>
    </div>
  </div>
  <a class="scrollcue" href="#play" aria-label={T.scroll}><i></i></a>
  <div class="edge" aria-hidden="true"></div>
</section>

<!-- ═════════ TICKER ═════════ -->
<div class="ticker" aria-hidden="true">
  <div class="tk">
    {[0, 1].map(() => (
      <span>{T.tick.map((s, i) => <><b>{s}</b><i class={'c-' + tkEl[i]}></i></>)}</span>
    ))}
  </div>
</div>

<!-- ═════════ PLAY：玩法 + 可以玩的小示範 ═════════ -->
<section class="play sec" id="play">
  <div class="w play-grid">
    <div class="play-copy">
      <p class="eyebrow rv">HOW TO PLAY</p>
      <h2 class="h2 rv">{T.h_play[0]}<br />{T.h_play[1]}<mark>{T.h_play[2]}</mark>{T.h_play[3]}</h2>
      <p class="lead rv">{T.lead_play}</p>
      <ol class="steps">
        {T.steps.map((s, i) => <li class="rv"><b>{'0' + (i + 1)}</b><div><h3>{s[0]}</h3><p>{s[1]}</p></div></li>)}
      </ol>
    </div>

    <div class="demo rv" id="demo" data-state="idle">
      <span class="demo-tag">{T.demoTag}</span>
      <div class="demo-foe" style={`background-image:url(${ART}/bg/fire_back.webp)`}>
        <div class="foe">
          <div class="fi crop" style="--z:1.95;--cx:.516;--cy:.952;--by:97%"><img src={`${ART}/cards/c41_full.webp`} alt={T.foeAlt} width="1080" height="900" loading="lazy" draggable="false" /></div>
          <div class="hpbar"><i></i></div>
        </div>
      </div>
      <div class="demo-body">
        <div class="board" role="img" aria-label={T.boardAria}>
          {Array.from({ length: 81 }, (_, i) => {
            const b = Math.floor(Math.floor(i / 9) / 3) * 3 + Math.floor((i % 9) / 3);
            return <i class={'c ' + (boxEl[b] ? 'z-' + boxEl[b] : '')} data-i={i}></i>;
          })}
          <div class="hit" aria-live="polite"></div>
        </div>
        <div class="tray"><div class="piece" id="demoPiece" tabindex="0" role="button" aria-label={T.pieceAria}></div></div>
        <p class="demo-msg" id="demoMsg">{js.m1}</p>
      </div>
      <div class="demo-end">
        <p class="de-t">{T.deT}</p>
        <p class="de-d">{T.deD}</p>
        <a class="btn btn-go" href="/play/"><span class="bi" set:html={ico('play', 20)} /><span><b>{T.full}</b></span></a>
        <button class="again" type="button" id="demoAgain"><span set:html={ico('rotate-ccw', 15)} />{T.again}</button>
      </div>
    </div>
  </div>
</section>

<!-- ═════════ SCREENS：實機畫面 ═════════ -->
<section class="screens sec" id="screens">
  <div class="w scr-top">
    <div class="phone rv">
      <video muted loop playsinline preload="none" poster="/home/play-poster.webp" data-src="/home/play.mp4" width="480" height="982"></video>
      <span class="rec"><i></i>{T.rec}</span>
    </div>
    <div class="scr-copy">
      <p class="eyebrow rv">REAL GAMEPLAY</p>
      <h2 class="h2 rv">{T.h_scr[0]}<br />{T.h_scr[1]}<mark>{T.h_scr[2]}</mark>{T.h_scr[3]}</h2>
      <p class="lead rv">{T.lead_scr}</p>
      <div class="stickers rv" aria-hidden="true"><span class="st st-hit">9 HIT</span><span class="st st-combo">3 COMBO</span></div>
    </div>
  </div>
  <div class="rail-wrap rv">
    <div class="rail" id="rail" tabindex="0" aria-label={T.railAria}>
      {shots.map((s) => (
        <figure class="shot">
          <img src={`/home/shots/${s.f}.webp`} alt={`${s.t}: ${s.d}`} width="600" height="1229" loading="lazy" draggable="false" />
          <figcaption><b>{s.t}</b>{s.d}</figcaption>
        </figure>
      ))}
    </div>
    <div class="rail-nav"><button type="button" data-dir="-1" aria-label={T.prev} set:html={ico('chevron-left', 22)} /><button type="button" data-dir="1" aria-label={T.next} set:html={ico('chevron-right', 22)} /></div>
  </div>
</section>

<!-- ═════════ WORLD：大廳地圖 ═════════ -->
<section class="world sec" id="world">
  <div class="w">
    <div class="world-head">
      <p class="eyebrow rv">THE WORLD</p>
      <h2 class="h2 rv">{T.h_world[0]}<br />{T.h_world[1]}<mark>{T.h_world[2]}</mark>{T.h_world[3]}</h2>
      <p class="lead rv">{T.lead_world}</p>
    </div>
    <div class="world-grid">
      <div class="map rv" id="map">
        <img class="mc mc1" src={`${ART}/map/cloud_lbb.webp`} alt="" aria-hidden="true" loading="lazy" />
        <img class="mc mc2" src={`${ART}/map/cloud_rbb.webp`} alt="" aria-hidden="true" loading="lazy" />
        {places.map((p, i) => (
          <button type="button" class={'isl' + (i === 0 ? ' on' : '')} data-id={p.id} aria-label={p.name}
            style={`left:${p.pos.left}%;top:${p.pos.top}%;width:${p.pos.width}%;z-index:${p.pos.z};--fd:${(i * 0.7).toFixed(1)}s`}>
            <img src={p.isl} alt="" loading="lazy" draggable="false" />
            <span class="isl-tag">{p.name}</span>
          </button>
        ))}
        <img class="mc mc3" src={`${ART}/map/cloud_r.webp`} alt="" aria-hidden="true" loading="lazy" />
      </div>
      <div class="panel rv" id="panel" aria-live="polite">
        <div class="pn-bg"><div class="pn-foes"></div></div>
        <div class="pn-body">
          <div class="pn-chips"></div>
          <h3 class="pn-name"></h3>
          <p class="pn-tip"></p>
          <p class="pn-foe"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═════════ HEROES：隊伍與進化 ═════════ -->
<section class="heroes sec" id="heroes">
  <div class="w">
    <div class="heroes-head">
      <p class="eyebrow rv">HEROES</p>
      <h2 class="h2 rv">{T.h_hero[0]}<br />{T.h_hero[1]}<mark>{T.h_hero[2]}</mark>{T.h_hero[3]}</h2>
    </div>
    <div class="tabs rv" role="tablist" id="tabs">
      {teams.map((t, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-t={i}>{t.name}</button>)}
    </div>
    <div class="stagebox rv" id="stagebox">
      <div class="sb-art">
        <i class="sb-glow"></i>
        <img id="sbImg" src={teams[0].heroes[0].st[0].u} alt="" width="1080" height="900" />
        <span class="q" aria-hidden="true">?</span>
        <i class="sb-ped"></i>
      </div>
      <div class="sb-info">
        <p class="sb-team" id="sbTeam"></p>
        <h3 class="sb-name"><span id="sbName"></span><small id="sbEn"></small></h3>
        <div class="sb-chips" id="sbChips"></div>
        <div class="evo">
          <p class="evo-l">{T.evoL}</p>
          <div class="evo-b" id="evoB"></div>
        </div>
        <div class="mates" id="mates"></div>
      </div>
    </div>
    <p class="more rv"><a class="lnk" href="/dex/">{T.dex}<span set:html={ico('arrow-right', 16)} /></a></p>
  </div>
</section>

<!-- ═════════ NUMBERS ═════════ -->
<section class="nums" aria-label="Numbers">
  <div class="w nums-in">
    {T.nums.map((n) => <div class="num rv"><b data-n={n[0]}>{n[0]}</b><span>{n[1]}</span></div>)}
  </div>
</section>

<!-- ═════════ MAKER：開發者 ═════════ -->
<section class="maker sec" id="maker">
  <div class="w maker-grid">
    <div class="note rv">
      <img class="av" src="/home/avatar.webp" alt="" width="256" height="256" loading="lazy" />
      <p class="eyebrow">FROM THE MAKER</p>
      <h2 class="h2 sm">{T.h_maker[0]}<br />{T.h_maker[1]}</h2>
      <div class="say">{T.say.map((s) => <p>{s}</p>)}</div>
      <p class="sig">{T.sig}</p>
    </div>
    <div class="logs">
      <p class="eyebrow rv">DEVLOG</p>
      <h3 class="h3 rv">{T.h_log}</h3>
      {T.logNote && <p class="lognote rv">{T.logNote}</p>}
      <ul>
        {posts.map((p) => <li class="rv"><a href={p.href}><time>{p.date}</time><span>{p.t}</span><i set:html={ico('arrow-right', 18)} /></a></li>)}
      </ul>
      <p class="rv"><a class="lnk" href="/devlog/">{T.allLog}<span set:html={ico('arrow-right', 16)} /></a></p>
    </div>
  </div>
</section>

<!-- ═════════ FAQ ═════════ -->
<section class="faq sec" id="faq">
  <div class="w faq-in">
    <div>
      <p class="eyebrow rv">FAQ</p>
      <h2 class="h2 sm rv">{T.h_faq[0]}<br />{T.h_faq[1]}</h2>
      <p class="rv"><a class="lnk" href={T.faqHref}>{T.moreFaq}<span set:html={ico('arrow-right', 16)} /></a></p>
    </div>
    <div class="qa">
      {faqs.map((f) => <details class="rv"><summary>{f.q}<i></i></summary><p>{f.a}</p></details>)}
    </div>
  </div>
</section>

<!-- ═════════ FINAL CTA ═════════ -->
<section class="final">
  <div class="sky" aria-hidden="true">
    <i class="sun"></i>
    <i class="cube c-fire" style="--x:12%;--y:26%;--s:44px;--r:-14deg;--t:7s"></i>
    <i class="cube c-water" style="--x:86%;--y:18%;--s:36px;--r:16deg;--t:9s"></i>
    <i class="cube c-wind" style="--x:90%;--y:70%;--s:30px;--r:-18deg;--t:10s"></i>
  </div>
  <div class="w final-in">
    <img class="final-isl rv" src="/home/hero-island-640.webp" alt="" width="640" height="626" loading="lazy" />
    <h2 class="h2 rv">{T.h_final[0]}<br />{T.h_final[1]}</h2>
    <a class="btn btn-go big rv" href="/play/"><span class="bi" set:html={ico('play', 24)} /><span><b>{T.play}</b><small>{T.playS2}</small></span></a>
    <p class="follow rv"><span>{T.follow}</span>
      <a href="https://www.facebook.com/profile.php?id=61596736017983" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.instagram.com/blockyusha" target="_blank" rel="noopener">Instagram</a>
      <a href="https://x.com/blockyusha" target="_blank" rel="noopener">X</a>
      <a href="https://youtube.com/@blockyusha" target="_blank" rel="noopener">YouTube</a>
    </p>
  </div>
</section>

</main>
<script type="application/json" id="hp-data" set:html={JSON.stringify(data)} />
<HomeStyle />
<HomeScript />
</Base>
