  { id: 'thunder', name: L('雷之高原', 'Thunder Plateau'), el: 'thunder', tip: L('充滿影響盤面的技能怪，要用高技巧排盤面。', 'Monsters here mess with your board. Bring your best block-placing.'), foe: L('鐵機人', 'Iron Bots'), fid: 'c38', bg: 'thunder', pos: isle(215, 940, 430, 481) },
