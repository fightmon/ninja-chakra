// 美術一律引用 /play/art/(=遊戲本體同一份檔)，所以遊戲換圖這裡自動跟著換。
import Base from '../layouts/Base.astro';
import HomeStyle from './HomeStyle.astro';
import HomeScript from './HomeScript.astro';
import fs from 'node:fs';
import path from 'node:path';
import { byId } from '../data/cards';

export interface Props { lang?: 'zh-TW' | 'en' }
const { lang = 'zh-TW' } = Astro.props;
const en = lang === 'en';
function L<V>(zh: V, e: V): V { return en ? e : zh; }

const ART = '/play/art';
const root = process.cwd();
const cardDir = path.join(root, 'public/play/art/cards');
const has = (f: string) => fs.existsSync(path.join(cardDir, f));
const ico = (n: string, size = 20) =>
  fs.readFileSync(path.join(root, 'node_modules/lucide-static/icons', n + '.svg'), 'utf8')
    .replace(/<!--[\s\S]*?-->/g, '').replace('width="24"', `width="${size}"`).replace('height="24"', `height="${size}"`).replace(/\s+/g, ' ').trim();

// 進化階段：遊戲裡有哪幾階的圖就列哪幾階
const stageFiles = (id: string, king = false) => {
  const s = [`${id}_full.webp`];
  for (const k of ['e', 'e2', 'e3']) if (has(`${id}_${k}_full.webp`)) s.push(`${id}_${k}_full.webp`);
  if (king && has(`${id}_king_full.webp`)) s.push(`${id}_king_full.webp`);
  return s.map((f) => `${ART}/cards/${f}`);
};
// 量每張圖去掉透明邊後的實際內容範圍，裁切與縮放都照這個算，怪和角色才不會被切到
let sharpLib: any = null;
try { sharpLib = (await import('sharp')).default; } catch {}
const bboxCache = new Map<string, { cx: number; bot: number; bw: number; bh: number; ar: number }>();
const bbox = async (url: string) => {
  const hit = bboxCache.get(url); if (hit) return hit;
  let r = { cx: 0.5, bot: 0.94, bw: 0.62, bh: 0.6, ar: 900 / 1080 };
  try {
    if (sharpLib) {
      const file = path.join(root, 'public', url);
      const m = await sharpLib(file).metadata();
      const { info } = await sharpLib(file).trim({ threshold: 60 }).toBuffer({ resolveWithObject: true });
      const x0 = -(info.trimOffsetLeft ?? 0), y0 = -(info.trimOffsetTop ?? 0);
      r = { cx: (x0 + info.width / 2) / m.width, bot: (y0 + info.height) / m.height, bw: info.width / m.width, bh: info.height / m.height, ar: m.height / m.width };
    }
  } catch {}
  bboxCache.set(url, r); return r;
};
const r4 = (n: number) => +n.toFixed(4);
// 地圖面板的怪：方形框，內容完整放進去、腳貼底，四階由小到大
const foeCrops = (urls: string[]) => Promise.all(urls.map(async (u, i) => {
  const b = await bbox(u), k = urls.length === 4 ? i : Math.min(i + (4 - urls.length), 3);
  const fit = Math.min(0.94 / b.bw, 0.9 / (b.bh * b.ar));
  return { u, k, z: r4(fit * [0.8, 0.87, 0.94, 1][k]), cx: r4(b.cx), cy: r4(b.bot * b.ar / (900 / 1080)) };
}));
// 首頁最多演到第幾階(目前先不露出第 4 階)；最後一階要不要只給剪影
const MAX_STAGE = 3, TEASE_LAST = true;
const heroStages = async (id: string) => {
  const urls = stageFiles(id).slice(0, MAX_STAGE), lad = urls.length >= 3 ? [0.85, 0.93, 1] : [0.9, 1];
  return Promise.all(urls.map(async (u, i) => {
    const b = await bbox(u);
    return { u, sc: r4(Math.min(1.9, Math.min(0.88 / b.bw, 0.84 / b.bh) * (lad[i] ?? 1))), ox: r4(b.cx * 100), oy: r4(b.bot * 100), tx: r4(50 - b.cx * 100), ty: r4(88 - b.bot * 100), t: TEASE_LAST && urls.length >= 3 && i === urls.length - 1 ? 1 : 0 };
  }));
};
const cardCount = new Set(fs.readdirSync(cardDir).map((f) => f.split('_')[0])).size;

